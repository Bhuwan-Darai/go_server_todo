# Stage 1: Build stage
FROM golang:1.24-alpine AS build

WORKDIR /workspace

# Install git for Go modules and Node.js/npm for Prisma CLI
RUN apk add --no-cache git nodejs npm



# Install Prisma CLI
RUN npm install prisma --save-dev

# Generate Prisma client with Prisma CLI
RUN npx prisma generate --schema=./prisma/schema.prisma

# Copy Prisma schema and go.mod/go.sum
COPY prisma/schema.prisma ./prisma/
COPY go.mod go.sum ./


# Install Prisma client Go dependencies
RUN go run github.com/steebchen/prisma-client-go prefetch

# Generate Prisma client for Go
RUN go run github.com/steebchen/prisma-client-go generate

# Download remaining Go dependencies
RUN go mod download

# Copy the entire project
COPY . .

# Verify platform-specific query engine
RUN if [ ! -f prisma/db/prisma-client/query-engine-linux-static-x64_gen.go ]; then \
    echo "❌ ERROR: Linux static query engine not found!"; \
    exit 1; \
    fi

# Build the binary with Render's flags for static linking
RUN GOOS=linux GOARCH=amd64 go build -tags netgo -ldflags '-s -w' -o /app/app .

# Stage 2: Minimal runtime image
FROM alpine:latest

WORKDIR /app

# Install CA certificates and wget for health checks
RUN apk add --no-cache ca-certificates wget

# Copy the binary from the build stage
COPY --from=build /app/app /app/app

# Copy Prisma schema and migrations
COPY --from=build /workspace/prisma ./prisma

# Ensure the binary is executable
RUN chmod +x /app/app

# Expose the port (Render uses PORT env var)
EXPOSE 8000
ENV PORT=8000
ENV ENV=production

# Add health check for Render
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
    CMD wget --spider http://localhost:8000/health || exit 1

# Run the application
CMD ["/app/app"]





