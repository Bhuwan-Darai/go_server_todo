# Stage 1: Generate Prisma Go client
FROM node:18-alpine as prisma-builder

WORKDIR /app

# Install Prisma CLI, curl, and Go
RUN apk add --no-cache curl go

# Copy necessary files
COPY go.mod go.sum ./
COPY prisma ./prisma

# Install Prisma CLI
RUN npm install -g prisma

# Run Prisma CLI generate and db push
RUN npx prisma generate --binary-target=linux-musl && \
    echo "Prisma CLI generate completed" && \
    ls -la ./prisma && \
    npx prisma db push --accept-data-loss && \
    echo "Prisma db push completed" && \
    ls -la ./prisma

# Install Prisma Client Go
RUN curl -sSL https://github.com/steebchen/prisma-client-go/releases/latest/download/prisma-client-go.sh | sh

# Generate Prisma Client Go for linux-musl and list files
RUN go run github.com/steebchen/prisma-client-go generate --binary-target=linux-musl && \
    echo "Prisma Client Go generation completed" && \
    ls -la ./prisma/db/prisma-client && \
    echo "Files in prisma/db/prisma-client after generation:"

# Download query engine binary for linux-musl and move to expected location
RUN go run github.com/steebchen/prisma-client-go prefetch --binary-target=linux-musl && \
    ls -la ./prisma && \
    echo "Query engine prefetch completed" && \
    mv ./prisma/query-engine-linux-musl ./prisma/db/prisma-client/query-engine || echo "Failed to move query-engine-linux-musl" && \
    chmod +x ./prisma/db/prisma-client/query-engine || echo "Failed to chmod query-engine" && \
    ls -la ./prisma/db/prisma-client && \
    echo "Files in prisma/db/prisma-client after moving query engine:"

# Stage 2: Build the Go binary
FROM golang:1.21-alpine as builder

WORKDIR /app

# Install Git for Go modules
RUN apk add --no-cache git

COPY go.mod go.sum ./
RUN go mod download

# Copy source code and generated Prisma client
COPY . .
COPY --from=prisma-builder /app/prisma/db/prisma-client ./prisma/db/prisma-client
COPY --from=prisma-builder /app/prisma ./prisma

# Debug: Verify copied files
RUN ls -la ./prisma && \
    ls -la ./prisma/db/prisma-client && \
    echo "Files in prisma/db/prisma-client in builder stage:" && \
    ls -la ./prisma/db/prisma-client/query-engine || echo "Query engine not found in builder stage"

# Build your Go app
RUN go build -o main .

# Stage 3: Final image
FROM alpine:latest

WORKDIR /app

# Add CA certificates and musl compatibility
RUN apk add --no-cache ca-certificates libc6-compat

# Copy the compiled binary
COPY --from=builder /app/main .

# Copy the Prisma schema and query engine
COPY --from=prisma-builder /app/prisma ./prisma

# Debug: Verify files in final image and confirm query engine presence
RUN ls -la ./prisma && \
    ls -la ./prisma/db/prisma-client && \
    echo "Files in prisma/db/prisma-client in final image:" && \
    if [ -f ./prisma/db/prisma-client/query-engine ]; then \
        echo "Query engine found"; \
        chmod +x ./prisma/db/prisma-client/query-engine; \
    else \
        echo "Query engine not found in final image"; \
    fi && \
    find ./prisma -name "query-engine*" -type f

# Default port
EXPOSE 8000

# Set environment variables
ENV PORT=8000
ENV ENV=production

CMD ["./main"]