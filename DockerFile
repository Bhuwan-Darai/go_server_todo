# Stage 1: Builder
FROM golang:1.23-alpine AS builder

WORKDIR /app

# Install required packages
RUN apk add --no-cache git gcc musl-dev

# Copy go.mod and go.sum first
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy the full source
COPY . .

# Install gqlgen tool locally
RUN go install github.com/99designs/gqlgen@v0.17.74

# Run gqlgen codegen (requires gqlgen.yml, schema, and Go types to exist)
RUN /go/bin/gqlgen generate

# Build binary (static)
RUN CGO_ENABLED=0 GOOS=linux go build -o main .

# Stage 2: Runtime
FROM alpine:latest

RUN apk add --no-cache ca-certificates

WORKDIR /app

COPY --from=builder /app/main .

# COPY --from=builder /app/.env ./  # optional

EXPOSE 8000

CMD ["./main"]