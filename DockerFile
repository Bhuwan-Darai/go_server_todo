# Stage 1: Generate Prisma Go client
FROM node:18-alpine as prisma-builder

WORKDIR /app

# Install Prisma CLI, curl, and Go
RUN apk add --no-cache curl go

# Copy necessary files
COPY go.mod go.sum ./
COPY prisma ./prisma

# Install Prisma CLI
RUN npm install -g prisma

# Run Prisma CLI generate to process the schema
RUN npx prisma generate && \
    ls -la ./prisma && \
    echo "Prisma CLI generate completed"

# Install Prisma Client Go
RUN curl -sSL https://github.com/steebchen/prisma-client-go/releases/latest/download/prisma-client-go.sh | sh

# Generate Prisma Client Go and debug output
RUN go run github.com/steebchen/prisma-client-go generate && \
    ls -la ./prisma/db/prisma-client && \
    echo "Prisma Client Go generation completed"

# Download query engine binary
RUN go run github.com/steebchen/prisma-client-go prefetch && \
    ls -la ./prisma && \
    echo "Query engine prefetch completed"

# Stage 2: Build the Go binary
FROM golang:1.21-alpine as builder

WORKDIR /app

# Install Git for Go modules
RUN apk add --no-cache git

COPY go.mod go.sum ./
RUN go mod download

# Copy source code and generated Prisma client
COPY . .
COPY --from=prisma-builder /app/prisma/db/prisma-client ./prisma/db/prisma-client
COPY --from=prisma-builder /app/prisma ./prisma

# Debug: Verify copied files
RUN ls -la ./prisma && ls -la ./prisma/db/prisma-client

# Build your Go app
RUN go build -o main .

# Stage 3: Final image
FROM alpine:latest

WORKDIR /root/

# Add CA certificates
RUN apk add --no-cache ca-certificates

# Copy the compiled binary
COPY --from=builder /app/main .

# Copy the Prisma schema and query engine
COPY --from=prisma-builder /app/prisma ./prisma

# Debug: Verify files in final image
RUN ls -la ./prisma && \
    ls -la ./prisma/db/prisma-client && \
    chmod +x ./prisma/query-engine || echo "Query engine not found"

# Default port
EXPOSE 8000

CMD ["./main"]