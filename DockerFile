# Stage 1: Builder
FROM golang:1.23-alpine AS builder

WORKDIR /app

# Install needed packages
RUN apk add --no-cache git gcc musl-dev

# Copy Go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source
COPY . .

# Optional: gqlgen codegen (if used)
RUN go install github.com/99designs/gqlgen@v0.17.74
RUN /go/bin/gqlgen generate || echo "Skipping gqlgen generate (not needed or already done)"

# Build binary
RUN CGO_ENABLED=0 GOOS=linux go build -o main .

# Stage 2: Runtime
FROM alpine:latest

RUN apk add --no-cache ca-certificates

WORKDIR /app

COPY --from=builder /app/main .

# Expose the port your app will use
EXPOSE 8000

# Run the binary
CMD ["./main"]
