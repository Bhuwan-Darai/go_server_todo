# Stage 1: Build
FROM golang:1.24 as build

WORKDIR /app

# Add Go modules
COPY go.mod go.sum ./
RUN go mod download

# (Optional) Prisma client generation
RUN go install github.com/steebchen/prisma-client-go@latest
COPY . .

# Generate Prisma client (optional)
RUN go generate ./...

# Build the binary
RUN go build -o app .

# Final stage: Run binary
FROM alpine:latest

WORKDIR /root/
COPY --from=build /app/app .

EXPOSE 8000
ENV PORT=8000
ENV ENV=production

CMD ["./app"]

