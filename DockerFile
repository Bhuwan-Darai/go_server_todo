# Stage 1: Generate Prisma Go client and fetch query engine
FROM node:18-alpine as prisma-builder

WORKDIR /app

# Install required tools
RUN apk add --no-cache curl go git

# Copy schema and dependencies
COPY go.mod go.sum ./
COPY prisma ./prisma

# Install Prisma CLI
RUN npm install -g prisma

# Run Prisma generate + db push
RUN npx prisma generate --binary-target=linux-musl && \
    npx prisma db push --accept-data-loss

# Install Prisma Client Go CLI
RUN curl -sSL https://github.com/steebchen/prisma-client-go/releases/latest/download/prisma-client-go.sh | sh

# Generate Prisma Go client with explicit binary target
RUN GOOS=linux GOARCH=amd64 go run github.com/steebchen/prisma-client-go generate --binary-target=linux-musl

# Download and setup query engine binary explicitly
RUN mkdir -p ./prisma/db/prisma-client && \
    curl -L https://binaries.prisma.sh/all_commits/5e91ac6b6a6fd5269b456d6063faed3d59a1700c/linux-musl/query-engine.gz -o ./prisma/db/prisma-client/query-engine.gz && \
    gunzip ./prisma/db/prisma-client/query-engine.gz && \
    chmod +x ./prisma/db/prisma-client/query-engine && \
    ls -la ./prisma/db/prisma-client/

# Stage 2: Build the Go application
FROM golang:1.21-alpine as builder

WORKDIR /app

# Install Git for Go modules
RUN apk add --no-cache git

# Download dependencies
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Copy generated Prisma client and query engine from previous stage
COPY --from=prisma-builder /app/prisma/db/prisma-client ./prisma/db/prisma-client
COPY --from=prisma-builder /app/prisma/schema.prisma ./prisma/schema.prisma

# Build the Go binary
RUN GOOS=linux GOARCH=amd64 go build -o main .

# Stage 3: Final runtime image
FROM alpine:latest

WORKDIR /app

# Required for Alpine compatibility
RUN apk add --no-cache ca-certificates libc6-compat

# Copy built binary
COPY --from=builder /app/main .

# Copy generated Prisma client and query engine
COPY --from=prisma-builder /app/prisma/db/prisma-client ./prisma/db/prisma-client
COPY --from=prisma-builder /app/prisma/schema.prisma ./prisma/schema.prisma

# Set up proper permissions and verify query engine
RUN chmod +x ./prisma/db/prisma-client/query-engine && \
    ls -la ./prisma/db/prisma-client/ && \
    if [ -f ./prisma/db/prisma-client/query-engine ]; then \
        echo "✅ Query engine found in final image"; \
    else \
        echo "❌ ERROR: Query engine missing in final image!"; \
        exit 1; \
    fi

# Expose port and start app
EXPOSE 8000
ENV PORT=8000
ENV ENV=production

CMD ["./main"]