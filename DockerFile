# Stage 1: Generate Prisma Go client
FROM node:18-alpine as prisma-builder

WORKDIR /app

# Install Prisma CLI and curl
RUN apk add --no-cache curl

# Copy necessary files
COPY go.mod go.sum ./
COPY prisma ./prisma

# Install Prisma CLI
RUN npm install -g prisma

# Install Go and generate the Prisma client
RUN curl -sSL https://github.com/steebchen/prisma-client-go/releases/latest/download/prisma-client-go.sh | sh
RUN go run github.com/steebchen/prisma-client-go generate

# Stage 2: Build the Go binary
FROM golang:1.21-alpine as builder

WORKDIR /app

# Install Git for Go modules
RUN apk add --no-cache git

COPY go.mod go.sum ./
RUN go mod download

# Copy everything, including generated Prisma client from prisma-builder
COPY . .
COPY --from=prisma-builder /app/prisma/db/prisma-client ./prisma/db/prisma-client

# Build your Go app
RUN go build -o main .

# Stage 3: Final image
FROM alpine:latest

WORKDIR /root/

# Add CA certs
RUN apk add --no-cache ca-certificates

# Copy the compiled binary and Prisma client with engine
COPY --from=builder /app/main .
COPY --from=builder /app/prisma ./prisma

# Default port
EXPOSE 8080

CMD ["./main"]
