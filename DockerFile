# Stage 1: Build Prisma client
FROM node:18-alpine as prisma-builder

WORKDIR /app

# Copy only prisma schema files to install client
COPY prisma ./prisma
COPY go.mod go.sum ./
RUN apk add --no-cache curl

# Install Prisma CLI
RUN npm install -g prisma

# Initialize prisma client-go
RUN curl -sSL https://github.com/steebchen/prisma-client-go/releases/latest/download/prisma-client-go.sh | sh

# Generate the Prisma client
RUN prisma generate

# Stage 2: Build Go binary
FROM golang:1.21-alpine as builder

WORKDIR /app

COPY --from=prisma-builder /app /app

# Install required dependencies
RUN apk add --no-cache git

# Copy source code
COPY . .

# Download Go dependencies
RUN go mod download

# Build the Go app
RUN go build -o main .

# Final stage: Create a minimal image
FROM alpine:latest

WORKDIR /root/

# Install necessary CA certs
RUN apk add --no-cache ca-certificates

COPY --from=builder /app/main .
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/generated ./generated

# Expose the port your app runs on
EXPOSE 8080

# Command to run the app
CMD ["./main"]
