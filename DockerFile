FROM golang:1.22-alpine

# Install dependencies
RUN apk add --no-cache git gcc musl-dev

# Set working directory
WORKDIR /app

# Copy go modules and download them
COPY go.mod ./
COPY go.sum ./
RUN go mod download

# Install Prisma CLI and prisma-client-go
RUN go install github.com/steebchen/prisma-client-go@latest

# Copy Prisma schema
COPY prisma ./prisma

# Generate Prisma client with explicit binary targets
RUN go run github.com/steebchen/prisma-client-go generate --binary-targets=native,linux-musl

# Verify Prisma client generation
RUN ls -la prisma/db/prisma-client || (echo "Prisma client generation failed" && exit 1)

# Copy rest of the app
COPY . .

# Build Go binary
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o app .

# Expose port and run app
EXPOSE 8000

# Set environment variables
ENV PORT=8000
ENV ENV=production

# Run the binary
CMD ["./app"]
